datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

enum ScrutinType {
  PRESIDENTIELLE
  EUROPEENNE
  LEGISLATIVE
  MUNICIPALE
}

model Election {
  id              String         @id @default(cuid())
  slug            String         @unique // ex: "presi-2022-t1", "muni-2026-t1", "muni-2026-paris-t1"
  type            ScrutinType
  annee           Int
  tour            Int            @default(1)
  dateScrutin     DateTime
  inscrits        Int?
  votants         Int?
  exprimes        Int?
  tauxAbstention  Float?
  commune         String?        // ex: "Paris", "Marseille", "Lyon", ou null pour national
  departement     String?        // ex: "Paris", "Bouches-du-Rhône", etc.
  resultats       ResultatReel[]
  sondages        SondageVague[]
}

model CandidatOuListe {
  id              String         @id @default(cuid())
  nom             String
  parti           String
  famille         String         // Gauche, Bloc Central, Droite, Extrême Droite, Écologiste, etc.
  couleurHex      String         // Code couleur officiel pour les graphiques
  resultats       ResultatReel[]
  mesuresSondages SondageMesure[]
}

model ResultatReel {
  id              String          @id @default(cuid())
  electionId      String
  election        Election        @relation(fields: [electionId], references: [id])
  candidatId      String
  candidat        CandidatOuListe @relation(fields: [candidatId], references: [id])
  voix            BigInt?
  pourcentage     Float           // Score officiel en %
  sieges          Int?            // Pour législatives, européennes, municipales
  statut          String?         // Elu, Battu, Qualifie, Maintien, Bascule
  commune         String?
  departement     String?

  @@unique([electionId, candidatId])
}

model Institut {
  id              String         @id @default(cuid())
  nom             String         @unique // Ipsos, Ifop, etc.
  sondages        SondageVague[]
}

model SondageVague {
  id                 String          @id @default(cuid())
  codeSondage        String?
  electionId         String
  election           Election        @relation(fields: [electionId], references: [id])
  institutId         String
  institut           Institut        @relation(fields: [institutId], references: [id])
  commanditaire      String?
  dateDebut          DateTime?
  dateFin            DateTime?
  datePublication    DateTime
  joursAvantScrutin  Int?
  tailleEchantillon  Int?
  methode            String?
  statut             String?         // "Dernier sondage", "Rolling", etc.
  estDernierSondage  Boolean         @default(false)
  mesures            SondageMesure[]
}

model SondageMesure {
  id                 String          @id @default(cuid())
  sondageVagueId     String
  sondageVague       SondageVague    @relation(fields: [sondageVagueId], references: [id])
  candidatId         String
  candidat           CandidatOuListe @relation(fields: [candidatId], references: [id])
  intentionVotePct   Float
  siegesMin          Int?
  siegesMax          Int?
}
